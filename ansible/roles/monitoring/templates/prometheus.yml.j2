global:
  scrape_interval: {{ scrape_interval }}
  evaluation_interval: 30s

scrape_configs:
  - job_name: pve-cluster
    metrics_path: /pve
    static_configs:
      - targets:
{% for h in groups['pve'] %}
          - "{{ hostvars[h].ansible_host }}:{{ pve_exporter_port }}"
{% endfor %}

  - job_name: node
    static_configs:
      - targets:
{% for h in groups['pve'] %}
          - "{{ hostvars[h].ansible_host }}:{{ node_exporter_port }}"
{% endfor %}

  - job_name: pbs
    static_configs:
      - targets: ["{{ pbs_host }}:8007"]